{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "module": "index.ts",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development bun run --watch src/index.ts",
        "build": "NODE_ENV=production bun build src/index.ts --target node --outdir dist",
        "start": "NODE_ENV=production bun run dist/index.js",
        "test": "NODE_ENV=test bun test --parallel=1",
        "db:generate": "bun --filter @workspace/db db:generate",
        "db:migrate": "bun --filter @workspace/db db:migrate",
        "db:migrate:prod": "bun --filter @workspace/db db:migrate:prod",
        "db:reset": "bun --filter @workspace/db db:reset",
        "db:studio": "bun --filter @workspace/db db:studio",
        "db:push": "bun --filter @workspace/db db:push",
        "setup": "bun install && bun run db:generate && bun run db:migrate",
        "reset": "bun run db:reset && bun run db:seed",
        "clean": "rm -rf dist node_modules .next",
        "typecheck": "tsc --noEmit",
        "type-check": "tsc --noEmit",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "add:module": "bun scripts/generate-module.ts",
        "bootstrap:admin": "bun scripts/bootstrap-superadmin.ts",
        "sync:permissions": "bun scripts/sync-permissions.ts",
        "db:seed": "bun scripts/seeds/index.ts",
        "seed:dummy": "bun scripts/seeds/index.ts"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.2.0",
        "@prisma/client-runtime-utils": "^7.9.1",
        "@socket.io/redis-adapter": "^8.3.0",
        "@workspace/cache": "workspace:*",
        "@workspace/db": "workspace:*",
        "@workspace/logger": "workspace:*",
        "@workspace/message-broker": "workspace:*",
        "@workspace/shared": "workspace:*",
        "@workspace/storage": "workspace:*",
        "argon2": "^0.45.1",
        "axios": "^1.12.2",
        "bcrypt": "^6.0.0",
        "chalk": "^5.6.0",
        "compression": "^1.8.1",
        "connect-timeout": "^1.9.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.0.1",
        "helmet": "^8.1.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21",
        "mongoose": "^8.9.0",
        "multer": "^2.0.2",
        "pg": "^8.16.3",
        "prisma": "^7.2.0",
        "socket.io": "^4.8.3",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.1.1"
    },
    "devDependencies": {
        "@types/pg": "^8.16.0",
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "latest",
        "@types/compression": "^1.8.1",
        "@types/connect-timeout": "^1.9.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.20",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.0.3"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
