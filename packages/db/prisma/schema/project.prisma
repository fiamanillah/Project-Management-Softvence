// ==========================================
// PROJECT ARCHITECTURE
// ==========================================

model Project {
  id            String    @id @default(uuid()) @db.Uuid
  parentId      String?   @map("parent_id") @db.Uuid
  parentOrderId String?   @map("parent_order_id")
  clientId      String    @map("client_id") @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  serviceLineId String?   @map("service_line_id") @db.Uuid
  statusId      String    @map("status_id") @db.Uuid
  orderId       String    @unique @map("order_id")
  projectName   String    @map("project_name")
  service       String?
  email         String?
  orderLink     String?   @map("order_link")
  orderSheetUrl String?   @map("order_sheet_url")
  value         Decimal   @db.Decimal
  amount        Decimal?  @db.Decimal
  percentage    Decimal?  @db.Decimal
  remarks       String?   @db.Text
  startDate     DateTime? @map("start_date")
  deliveryDate  DateTime? @map("delivery_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  parentProject Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subProjects   Project[] @relation("ProjectHierarchy")

  client      Client        @relation(fields: [clientId], references: [id])
  profile     Profile       @relation(fields: [profileId], references: [id])
  serviceLine ServiceLine?  @relation(fields: [serviceLineId], references: [id])
  status      ProjectStatus @relation(fields: [statusId], references: [id])

  components             ProjectComponent[]
  teamAssignments        ProjectTeamAssignment[]
  userAssignments        ProjectAssignment[]
  messages               Message[]
  platformThreadMessages PlatformThreadMessage[]
  issues                 Issue[]
  supportTickets         SupportTicket[]
  group                  ProjectGroup?
  scopeTargets           RolePermissionScopeTarget[]
  permissionOverrides    UserPermissionOverride[]

  @@index([parentId])
  @@index([parentOrderId])
  @@index([profileId])
  @@index([clientId])
  @@index([serviceLineId])
  @@index([statusId])
  @@index([statusId, deletedAt])
  @@map("projects")
}

model ProjectComponent {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  name      String
  statusId  String    @map("status_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id])
  status  ProjectStatus @relation(fields: [statusId], references: [id])

  teamAssignments ComponentTeamAssignment[]
  userAssignments ComponentAssignment[]
  issues          Issue[]

  @@index([projectId])
  @@index([statusId])
  @@map("project_components")
}

model ProjectTeamAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  project Project @relation(fields: [projectId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id])

  @@index([projectId, unassignedAt])
  @@index([teamId])
  @@map("project_team_assignments")
}

model ComponentTeamAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  componentId  String    @map("component_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  component ProjectComponent @relation(fields: [componentId], references: [id])
  team      Team             @relation(fields: [teamId], references: [id])

  @@index([componentId, unassignedAt])
  @@index([teamId])
  @@map("component_team_assignments")
}

model ProjectAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  project Project        @relation(fields: [projectId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  role    AssignmentRole @relation(fields: [roleId], references: [id])

  @@index([projectId, userId])
  @@index([userId, unassignedAt])
  @@index([roleId])
  @@map("project_assignments")
}

model ComponentAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  componentId  String    @map("component_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  component ProjectComponent @relation(fields: [componentId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  role      AssignmentRole   @relation(fields: [roleId], references: [id])

  @@index([componentId, userId])
  @@index([roleId])
  @@map("component_assignments")
}
