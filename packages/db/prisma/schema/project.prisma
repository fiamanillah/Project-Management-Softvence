// ==========================================
// PROJECT ARCHITECTURE
// ==========================================

model Project {
  id            String    @id @default(uuid()) @db.Uuid
  parentId      String?   @map("parent_id") @db.Uuid
  parentOrderId String?   @map("parent_order_id")
  branchId      String?   @map("branch_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  serviceLineId String?   @map("service_line_id") @db.Uuid
  statusId      String    @map("status_id") @db.Uuid
  orderSourceId String?   @map("order_source_id") @db.Uuid
  orderId       String    @unique @map("order_id")
  projectName   String    @map("project_name")
  service       String?
  email         String?
  orderLink     String?   @map("order_link")
  orderSheetUrl String?   @map("order_sheet_url")
  value         Decimal   @db.Decimal
  amount        Decimal?  @db.Decimal
  percentage    Decimal?  @db.Decimal
  remarks       String?   @db.Text
  startDate     DateTime? @map("start_date")
  deliveryDate  DateTime? @map("delivery_date")
  progress      Int       @default(0)
  budget        Decimal   @default(0) @db.Decimal
  deadline      DateTime? @map("deadline")
  isPinned      Boolean   @default(false) @map("is_pinned")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  parentProject Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subProjects   Project[] @relation("ProjectHierarchy")

  branch      Branch?       @relation(fields: [branchId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])
  profile     Profile       @relation(fields: [profileId], references: [id])
  serviceLine ServiceLine?  @relation(fields: [serviceLineId], references: [id])
  status      ProjectStatus @relation(fields: [statusId], references: [id])
  orderSource OrderSource?  @relation(fields: [orderSourceId], references: [id])

  components             ProjectComponent[]
  teamAssignments        ProjectTeamAssignment[]
  userAssignments        ProjectAssignment[]
  messages               Message[]
  platformThreadMessages PlatformThreadMessage[]
  issues                 Issue[]
  supportTickets         SupportTicket[]
  group                  ProjectGroup?
  scopeTargets           RolePermissionScopeTarget[]
  permissionOverrides    UserPermissionOverride[]
  milestones             ProjectMilestone[]
  links                  ProjectLink[]
  projectMessages        ProjectMessage[]

  @@index([parentId])
  @@index([parentOrderId])
  @@index([branchId])
  @@index([profileId])
  @@index([clientId])
  @@index([serviceLineId])
  @@index([orderSourceId])
  @@index([statusId])
  @@index([statusId, deletedAt])
  @@map("projects")
}

model ProjectComponent {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  name      String
  statusId  String    @map("status_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id])
  status  ProjectStatus @relation(fields: [statusId], references: [id])

  teamAssignments ComponentTeamAssignment[]
  userAssignments ComponentAssignment[]
  issues          Issue[]

  @@index([projectId])
  @@index([statusId])
  @@map("project_components")
}

model ProjectTeamAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  project Project @relation(fields: [projectId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id])

  @@index([projectId, unassignedAt])
  @@index([teamId])
  @@map("project_team_assignments")
}

model ComponentTeamAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  componentId  String    @map("component_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  component ProjectComponent @relation(fields: [componentId], references: [id])
  team      Team             @relation(fields: [teamId], references: [id])

  @@index([componentId, unassignedAt])
  @@index([teamId])
  @@map("component_team_assignments")
}

model ProjectAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  project Project        @relation(fields: [projectId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  role    AssignmentRole @relation(fields: [roleId], references: [id])

  @@index([projectId, userId])
  @@index([userId, unassignedAt])
  @@index([roleId])
  @@map("project_assignments")
}

model ComponentAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  componentId  String    @map("component_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  component ProjectComponent @relation(fields: [componentId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  role      AssignmentRole   @relation(fields: [roleId], references: [id])

  @@index([componentId, userId])
  @@index([roleId])
  @@map("component_assignments")
}

model ProjectMilestone {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  title            String
  dueDate          DateTime  @map("due_date")
  isCompleted      Boolean   @default(false) @map("is_completed")
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  deliverableCount Int       @default(0) @map("deliverable_count")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo       User?     @relation("ProjectMilestoneAssignee", fields: [assignedToUserId], references: [id])

  @@index([projectId, isCompleted])
  @@map("project_milestones")
}

model ProjectLink {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  title       String
  url         String
  category    String   // "Figma" | "GitHub" | "Jira" | "Docs" | "Staging" | "Other"
  description String?
  addedById   String   @map("added_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy     User     @relation("ProjectLinkAdder", fields: [addedById], references: [id])

  @@index([projectId])
  @@map("project_links")
}

