// ==========================================
// BUSINESS DEVELOPMENT DEPARTMENT
// ==========================================

model BdOrder {
  id          String    @id @default(uuid()) @db.Uuid
  orderTypeId String    @map("order_type_id") @db.Uuid
  platformId  String?   @map("platform_id") @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  statusId    String    @map("status_id") @db.Uuid
  title       String
  description String?   @db.Text
  targetUrl   String?   @map("target_url")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orderType BdOrderType   @relation(fields: [orderTypeId], references: [id])
  platform  Platform?     @relation(fields: [platformId], references: [id])
  team      Team          @relation(fields: [teamId], references: [id])
  status    ProjectStatus @relation(fields: [statusId], references: [id])
  creator   User          @relation(fields: [createdBy], references: [id])

  assignments BdOrderAssignment[]

  @@index([orderTypeId])
  @@index([platformId])
  @@index([teamId])
  @@index([statusId])
  @@index([createdBy])
  @@map("bd_orders")
}

model BdOrderAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  bdOrderId    String    @map("bd_order_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  note         String?

  bdOrder BdOrder        @relation(fields: [bdOrderId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  role    AssignmentRole @relation(fields: [roleId], references: [id])

  @@index([bdOrderId, userId])
  @@index([userId])
  @@index([userId, unassignedAt])
  @@index([roleId])
  @@map("bd_order_assignments")
}

