// ==========================================
// MESSAGES & APPROVAL STATE MACHINE
// ==========================================

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  issueId        String?       @map("issue_id") @db.Uuid
  authorId       String        @map("author_id") @db.Uuid
  messageTypeId  String        @map("message_type_id") @db.Uuid
  status         MessageStatus @default(Draft)
  currentContent String        @map("current_content") @db.Text
  pointValue     Int           @default(0) @map("point_value")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  project     Project     @relation(fields: [projectId], references: [id])
  issue       Issue?      @relation(fields: [issueId], references: [id])
  author      User        @relation("MessageAuthor", fields: [authorId], references: [id])
  messageType MessageType @relation(fields: [messageTypeId], references: [id])

  revisions              MessageRevision[]
  approvals              MessageApproval[]
  platformThreadMessages PlatformThreadMessage[]

  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([authorId])
  @@index([issueId])
  @@index([messageTypeId])
  @@map("messages")
}

model MessageRevision {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  content   String   @db.Text
  editedBy  String   @map("edited_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id])
  editor  User    @relation("MessageEditor", fields: [editedBy], references: [id])

  @@index([messageId])
  @@index([editedBy])
  @@map("message_revisions")
}

model MessageApproval {
  id         String        @id @default(uuid()) @db.Uuid
  messageId  String        @map("message_id") @db.Uuid
  approverId String        @map("approver_id") @db.Uuid
  decision   MessageStatus
  notes      String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  message  Message @relation(fields: [messageId], references: [id])
  approver User    @relation("MessageApprover", fields: [approverId], references: [id])

  @@index([messageId])
  @@index([approverId])
  @@map("message_approvals")
}

// ==========================================
// SHADOW INBOX
// ==========================================

model PlatformThreadMessage {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  profileId         String          @map("profile_id") @db.Uuid
  direction         ThreadDirection
  sourceMessageId   String?         @map("source_message_id") @db.Uuid
  content           String          @db.Text
  loggedBy          String          @map("logged_by") @db.Uuid
  platformTimestamp DateTime        @map("platform_timestamp")
  createdAt         DateTime        @default(now()) @map("created_at")

  project       Project  @relation(fields: [projectId], references: [id])
  profile       Profile  @relation(fields: [profileId], references: [id])
  sourceMessage Message? @relation(fields: [sourceMessageId], references: [id])
  logger        User     @relation("PlatformThreadLogger", fields: [loggedBy], references: [id])

  @@index([projectId, platformTimestamp])
  @@index([profileId])
  @@index([profileId, platformTimestamp])
  @@index([sourceMessageId])
  @@index([loggedBy])
  @@map("platform_thread_messages")
}

