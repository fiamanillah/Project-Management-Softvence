// ==========================================
// MESSAGES & APPROVAL STATE MACHINE
// ==========================================

model Message {
  id              String        @id @default(uuid()) @db.Uuid
  project_id      String        @db.Uuid
  author_id       String        @db.Uuid
  message_type    String?
  status          MessageStatus @default(Draft)
  current_content String        @db.Text
  point_value     Int           @default(0)
  created_at      DateTime      @default(now())
  updated_at      DateTime?     @updatedAt
  deleted_at      DateTime?

  project Project @relation(fields: [project_id], references: [id])
  author  User    @relation("MessageAuthor", fields: [author_id], references: [id])

  revisions              MessageRevision[]
  approvals              MessageApproval[]
  related_client_updates ClientUpdate[]

  @@index([project_id])
  @@index([project_id, status])
  @@index([author_id])
  @@map("messages")
}

model MessageRevision {
  id         String   @id @default(uuid()) @db.Uuid
  message_id String   @db.Uuid
  content    String   @db.Text
  edited_by  String   @db.Uuid
  created_at DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id])
  editor  User    @relation("MessageEditor", fields: [edited_by], references: [id])

  @@index([message_id])
  @@map("message_revisions")
}

model MessageApproval {
  id          String        @id @default(uuid()) @db.Uuid
  message_id  String        @db.Uuid
  approver_id String        @db.Uuid
  decision    MessageStatus
  notes       String?       @db.Text
  created_at  DateTime      @default(now())

  message  Message @relation(fields: [message_id], references: [id])
  approver User    @relation("MessageApprover", fields: [approver_id], references: [id])

  @@index([message_id])
  @@map("message_approvals")
}

model ClientUpdate {
  id                   String   @id @default(uuid()) @db.Uuid
  project_id           String   @db.Uuid
  profile_id           String   @db.Uuid
  received_by          String   @db.Uuid
  content              String   @db.Text
  routed_to_message_id String?  @db.Uuid
  created_at           DateTime @default(now())

  project           Project  @relation(fields: [project_id], references: [id])
  profile           Profile  @relation(fields: [profile_id], references: [id])
  receiver          User     @relation("ClientUpdateReceiver", fields: [received_by], references: [id])
  routed_to_message Message? @relation(fields: [routed_to_message_id], references: [id])

  @@index([project_id])
  @@index([profile_id])
  @@map("client_updates")
}
