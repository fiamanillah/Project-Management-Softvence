// ==========================================
// CORE IDENTITY & ACCESS
// ==========================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  employeeId         String     @unique @map("employee_id")
  email              String     @unique
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  systemRole         SystemRole @default(Staff) @map("system_role")
  status             UserStatus @default(INVITED) @map("status")
  branchId           String?    @map("branch_id") @db.Uuid
  roleId             String?    @map("role_id") @db.Uuid
  designationId      String?    @map("designation_id") @db.Uuid
  avatarUrl          String?    @map("avatar_url")
  isActive           Boolean    @default(true) @map("is_active")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime?  @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  branch      Branch?      @relation(fields: [branchId], references: [id])
  role        Role?        @relation(fields: [roleId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])

  // Relations
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  managedBranches             BranchManager[]
  managedDepartments          DepartmentManager[]
  teamMemberships             TeamMember[]
  grantedRolePermissions      RolePermission[]                 @relation("RolePermissionGranter")
  receivedPermissionOverrides UserPermissionOverride[]         @relation("OverrideUser")
  grantedPermissionOverrides  UserPermissionOverride[]         @relation("OverrideGranter")
  absences                    UserAbsence[]                    @relation("AbsenceUser")
  absenceCovers               UserAbsence[]                    @relation("AbsenceCover")
  createdAbsences             UserAbsence[]                    @relation("AbsenceCreator")
  profileAssignments          ProfileSeller[]
  projectAssignments          ProjectAssignment[]
  componentAssignments        ComponentAssignment[]
  messages                    Message[]                        @relation("MessageAuthor")
  messageRevisions            MessageRevision[]                @relation("MessageEditor")
  messageApprovals            MessageApproval[]                @relation("MessageApprover")
  loggedPlatformMessages      PlatformThreadMessage[]          @relation("PlatformThreadLogger")
  createdIssues               Issue[]                          @relation("IssueAuthor")
  resolvedIssues              Issue[]                          @relation("IssueResolver")
  issueComments               IssueComment[]
  supportTickets              SupportTicket[]
  projectGroupMemberships     ProjectGroupMember[]             @relation("GroupMemberUser")
  addedProjectGroupMembers    ProjectGroupMember[]             @relation("GroupMemberAdder")
  chatMessages                ChatMessage[]
  chatMessageReads            ChatMessageRead[]
  createdBdOrders             BdOrder[]
  bdOrderAssignments          BdOrderAssignment[]
  attachments                 Attachment[]
  notifications               Notification[]
  madeDelegations             Delegation[]                     @relation("Delegator")
  receivedDelegations         Delegation[]                     @relation("Delegatee")
  createdDelegations          Delegation[]                     @relation("DelegationCreator")
  sentProjectMessages         ProjectMessage[]                 @relation("ProjectMessageSender")
  pinnedProjectMessages       ProjectMessage[]                 @relation("ProjectMessagePinnedBy")
  requestedApprovalWorkflows  MessageApprovalWorkflow[]        @relation("WorkflowRequestedBy")
  leadApprovedWorkflows       MessageApprovalWorkflow[]        @relation("WorkflowLeadApprover")
  salesDispatchedWorkflows    MessageApprovalWorkflow[]        @relation("WorkflowSalesDispatcher")
  rejectedWorkflows           MessageApprovalWorkflow[]        @relation("WorkflowRejector")
  approvalStageAudits         ApprovalStageAudit[]
  projectMessageReactions     ProjectMessageReaction[]
  projectMessageReadReceipts  ProjectMessageReadReceipt[]
  assignedProjectMilestones   ProjectMilestone[]               @relation("ProjectMilestoneAssignee")
  addedProjectLinks           ProjectLink[]                    @relation("ProjectLinkAdder")
  editedProjectMessages       ProjectMessageRevision[]         @relation("ProjectMessageEditor")
  stationAssignments          StationUserAssignment[]          @relation("StationUserAssignee")
  assignedStationUsers        StationUserAssignment[]          @relation("StationUserAssigner")
  unassignedStationUsers      StationUserAssignment[]          @relation("StationUserUnassigner")
  assignedStationProfiles     StationProfileAssignment[]       @relation("StationProfileAssigner")
  unassignedStationProfiles   StationProfileAssignment[]       @relation("StationProfileUnassigner")
  stationSessions             StationSession[]                 @relation("UserStationSessions")

  @@index([branchId])
  @@index([roleId])
  @@index([designationId])
  @@index([isActive, deletedAt])
  @@index([status, deletedAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stationSessions StationSession[]

  @@index([userId])
  @@index([userId, expiresAt, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------
// AUTHORIZATION ROLE (Holds Scoped Permission Grants)
// ----------------------------------------------------
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  description    String?
  departmentId   String?  @map("department_id") @db.Uuid
  hierarchyLevel Int      @default(1) @map("hierarchy_level")
  isLeadership   Boolean  @default(false) @map("is_leadership")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  department Department? @relation(fields: [departmentId], references: [id])

  users       User[]
  permissions RolePermission[]

  @@index([departmentId])
  @@map("roles")
}

// ----------------------------------------------------
// DESIGNATION (Pure Corporate Job Title / HR Metadata)
// ----------------------------------------------------
model Designation {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  departmentId   String?  @map("department_id") @db.Uuid
  hierarchyLevel Int      @default(1) @map("hierarchy_level")
  isLeadership   Boolean  @default(false) @map("is_leadership")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  department Department? @relation(fields: [departmentId], references: [id])
  users      User[]

  @@index([departmentId])
  @@map("designations")
}

model Permission {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  description     String?
  module          String?
  supportedScopes String[]  @default([]) @map("supported_scopes")
  implies         String[]  @default([]) @map("implies")
  dependsOn       String[]  @default([]) @map("depends_on")
  isActive        Boolean   @default(true) @map("is_active")
  deprecatedAt    DateTime? @map("deprecated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  rolePermissions      RolePermission[]
  permissionGroupItems PermissionGroupItem[]
  userOverrides        UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  scopeTypeId  String   @map("scope_type_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  grantedBy    String   @map("granted_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role         Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission          @relation(fields: [permissionId], references: [id])
  scopeType    PermissionScopeType @relation(fields: [scopeTypeId], references: [id])
  granter      User                @relation("RolePermissionGranter", fields: [grantedBy], references: [id])

  scopeTargets RolePermissionScopeTarget[]

  @@unique([roleId, permissionId])
  @@index([scopeTypeId])
  @@index([grantedBy])
  @@map("role_permissions")
}

model RolePermissionScopeTarget {
  id               String  @id @default(uuid()) @db.Uuid
  rolePermissionId String  @map("role_permission_id") @db.Uuid
  branchId         String? @map("branch_id") @db.Uuid
  departmentId     String? @map("department_id") @db.Uuid
  teamId           String? @map("team_id") @db.Uuid
  projectId        String? @map("project_id") @db.Uuid
  stationId        String? @map("station_id") @db.Uuid

  rolePermission RolePermission @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id])
  department     Department?    @relation(fields: [departmentId], references: [id])
  team           Team?          @relation(fields: [teamId], references: [id])
  project        Project?       @relation(fields: [projectId], references: [id])
  station        Station?       @relation(fields: [stationId], references: [id])

  @@index([rolePermissionId])
  @@index([branchId])
  @@index([departmentId])
  @@index([teamId])
  @@index([projectId])
  @@index([stationId])
  @@map("role_permission_scope_targets")
}

model UserPermissionOverride {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  teamId       String?   @map("team_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  stationId    String?   @map("station_id") @db.Uuid
  isDeny       Boolean   @default(false) @map("is_deny")
  grantedBy    String    @map("granted_by") @db.Uuid
  reason       String?
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User        @relation("OverrideUser", fields: [userId], references: [id])
  permission Permission  @relation(fields: [permissionId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  station    Station?    @relation(fields: [stationId], references: [id])
  granter    User        @relation("OverrideGranter", fields: [grantedBy], references: [id])

  @@unique([userId, permissionId, branchId, departmentId, teamId, projectId, stationId])
  @@index([userId, expiresAt])
  @@index([branchId])
  @@index([departmentId])
  @@index([teamId])
  @@index([projectId])
  @@index([stationId])
  @@index([grantedBy])
  @@map("user_permission_overrides")
}

model UserAbsence {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?
  coveredBy String?  @map("covered_by") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User  @relation("AbsenceUser", fields: [userId], references: [id])
  cover   User? @relation("AbsenceCover", fields: [coveredBy], references: [id])
  creator User  @relation("AbsenceCreator", fields: [createdBy], references: [id])

  @@index([userId, startAt, endAt])
  @@index([coveredBy])
  @@index([createdBy])
  @@map("user_absences")
}

