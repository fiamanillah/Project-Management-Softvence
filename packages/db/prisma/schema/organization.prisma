// ==========================================
// ORGANIZATION STRUCTURE
// ==========================================

model Branch {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  code        String    @unique
  name        String
  description String?
  email       String?
  phone       String?
  address     String?
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent      Branch?   @relation("BranchHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subBranches Branch[]  @relation("BranchHierarchy")

  managers        BranchManager[]
  departments     Department[]
  users           User[]
  projects        Project[]
  stations        Station[]
  scopeTargets    RolePermissionScopeTarget[]
  overrideTargets UserPermissionOverride[]

  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("branches")
}

model BranchManager {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleTitle    String?   @map("role_title")
  isPrimary    Boolean   @default(false) @map("is_primary")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId, unassignedAt])
  @@index([userId, unassignedAt])
  @@map("branch_managers")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  code      String    @unique
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branch         Branch?       @relation(fields: [branchId], references: [id])
  parent         Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subDepartments Department[]  @relation("DepartmentHierarchy")

  managers        DepartmentManager[]
  teams           Team[]
  roles           Role[]
  designations    Designation[]
  stations        Station[]
  scopeTargets    RolePermissionScopeTarget[]
  overrideTargets UserPermissionOverride[]

  @@index([branchId])
  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("departments")
}

model DepartmentManager {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleTitle    String?   @map("role_title")
  isPrimary    Boolean   @default(false) @map("is_primary")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  department Department @relation(fields: [departmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([departmentId, unassignedAt])
  @@index([userId, unassignedAt])
  @@map("department_managers")
}

model Team {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  name         String
  slug         String    @unique
  shift        String?
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])

  members              TeamMember[]
  projectAssignments   ProjectTeamAssignment[]
  componentAssignments ComponentTeamAssignment[]
  bdOrders             BdOrder[]
  scopeTargets         RolePermissionScopeTarget[]
  overrideTargets      UserPermissionOverride[]

  @@map("teams")
}

model TeamMember {
  id       String    @id @default(uuid()) @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  roleId   String    @map("role_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")
  note     String?

  team Team           @relation(fields: [teamId], references: [id])
  user User           @relation(fields: [userId], references: [id])
  role AssignmentRole @relation(fields: [roleId], references: [id])

  @@index([teamId, userId])
  @@index([userId, leftAt])
  @@index([roleId])
  @@map("team_members")
}

model ServiceLine {
  id                  String   @id @default(uuid()) @db.Uuid
  parentServiceLineId String?  @map("parent_service_line_id") @db.Uuid
  name                String
  slug                String   @unique
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  parentServiceLine ServiceLine?  @relation("ServiceLineHierarchy", fields: [parentServiceLineId], references: [id])
  childServiceLines ServiceLine[] @relation("ServiceLineHierarchy")

  projects Project[]

  @@index([parentServiceLineId])
  @@map("service_lines")
}
