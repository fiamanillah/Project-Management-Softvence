// ==========================================
// ORGANIZATION STRUCTURE
// ==========================================

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parent         Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subDepartments Department[]  @relation("DepartmentHierarchy")

  managers        DepartmentManager[]
  teams           Team[]
  designations    Designation[]
  scopeTargets    DesignationPermissionScopeTarget[]
  overrideTargets UserPermissionOverride[]

  @@index([parentId])
  @@map("departments")
}

model DepartmentManager {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  department Department @relation(fields: [departmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([departmentId, unassignedAt])
  @@index([userId, unassignedAt])
  @@map("department_managers")
}

model Team {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  name         String
  slug         String    @unique
  shift        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])

  members              TeamMember[]
  serviceLines         TeamServiceLine[]
  projectAssignments   ProjectTeamAssignment[]
  componentAssignments ComponentTeamAssignment[]
  bdOrders             BdOrder[]
  scopeTargets         DesignationPermissionScopeTarget[]
  overrideTargets      UserPermissionOverride[]

  @@map("teams")
}

model TeamMember {
  id       String    @id @default(uuid()) @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  roleId   String    @map("role_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")
  note     String?

  team Team           @relation(fields: [teamId], references: [id])
  user User           @relation(fields: [userId], references: [id])
  role AssignmentRole @relation(fields: [roleId], references: [id])

  @@index([teamId, userId])
  @@index([userId, leftAt])
  @@index([roleId])
  @@map("team_members")
}

model TeamServiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  serviceLineId String   @map("service_line_id") @db.Uuid
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  team        Team        @relation(fields: [teamId], references: [id])
  serviceLine ServiceLine @relation(fields: [serviceLineId], references: [id])

  @@unique([teamId, serviceLineId])
  @@index([serviceLineId])
  @@map("team_service_lines")
}

model ServiceLine {
  id                  String   @id @default(uuid()) @db.Uuid
  parentServiceLineId String?  @map("parent_service_line_id") @db.Uuid
  name                String
  slug                String   @unique
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  parentServiceLine ServiceLine?  @relation("ServiceLineHierarchy", fields: [parentServiceLineId], references: [id])
  childServiceLines ServiceLine[] @relation("ServiceLineHierarchy")

  teamServiceLines TeamServiceLine[]
  projects         Project[]

  @@index([parentServiceLineId])
  @@map("service_lines")
}
