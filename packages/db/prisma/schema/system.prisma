// ==========================================
// DYNAMIC LOOKUP TABLES
// ==========================================

model Platform {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  clients  Client[]
  profiles Profile[]
  bdOrders BdOrder[]

  @@map("platforms")
}

model ProjectStatus {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  requiresAction Boolean  @default(false) @map("requires_action")
  isTerminal     Boolean  @default(false) @map("is_terminal")
  sortOrder      Int      @default(0) @map("sort_order")
  color          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  projects   Project[]
  components ProjectComponent[]
  bdOrders   BdOrder[]

  @@map("project_statuses")
}

model Priority {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  level     Int
  color     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  issues Issue[]

  @@map("priorities")
}

model AssignmentRole {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique
  name                  String
  qualifiesForTeamScope Boolean  @default(false) @map("qualifies_for_team_scope")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  teamMembers          TeamMember[]
  projectAssignments   ProjectAssignment[]
  componentAssignments ComponentAssignment[]
  bdOrderAssignments   BdOrderAssignment[]

  @@map("assignment_roles")
}

model NotificationType {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique
  name                 String
  defaultTitleTemplate String?  @map("default_title_template")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  notifications Notification[]

  @@map("notification_types")
}

model MessageType {
  id               String                    @id @default(uuid()) @db.Uuid
  code             String                    @unique
  name             String
  label            String?
  direction        String                    @default("OUTBOUND") // "INTERNAL" | "OUTBOUND" | "INBOUND"
  colorHex         String                    @default("#10b981") @map("color_hex")
  description      String?
  icon             String?
  requiresApproval Boolean                   @default(false) @map("requires_approval")
  isSystem         Boolean                   @default(false) @map("is_system")
  isActive         Boolean                   @default(true) @map("is_active")
  sortOrder        Int                       @default(0) @map("sort_order")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime?                 @map("updated_at")

  messages         Message[]
  projectMessages  ProjectMessage[]

  @@index([direction, isActive])
  @@map("message_types")
}

model ApprovalStatusLookup {
  id                       String                    @id @default(uuid()) @db.Uuid
  code                     String                    @unique
  name                     String
  requiresLeadAction       Boolean                   @default(false) @map("requires_lead_action")
  requiresSalesAction      Boolean                   @default(false) @map("requires_sales_action")
  requiresAuthorRevision   Boolean                   @default(false) @map("requires_author_revision")
  requiresAutoApproveCheck Boolean                   @default(false) @map("requires_auto_approve_check")
  isTerminal               Boolean                   @default(false) @map("is_terminal")
  color                    String?
  sortOrder                Int                       @default(0) @map("sort_order")
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at")

  workflows                MessageApprovalWorkflow[]

  @@map("approval_status_lookups")
}


model OrderSource {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  projects Project[]

  @@map("order_sources")
}

model IssueType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  issues Issue[]

  @@map("issue_types")
}

model IssueStatusLookup {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  requiresAction Boolean  @default(false) @map("requires_action")
  isTerminal     Boolean  @default(false) @map("is_terminal")
  sortOrder      Int      @default(0) @map("sort_order")
  color          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  issues Issue[]

  @@map("issue_statuses")
}

model SupportTicketStatus {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  isTerminal Boolean  @default(false) @map("is_terminal")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  supportTickets SupportTicket[]

  @@map("support_ticket_statuses")
}

model BdOrderType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  bdOrders BdOrder[]

  @@map("bd_order_types")
}

model PermissionScopeType {
  id                 String                  @id @default(uuid()) @db.Uuid
  code               String                  @unique
  name               String
  description        String?
  resolutionStrategy ScopeResolutionStrategy @map("resolution_strategy")
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permission_scope_types")
}

model PermissionGroup {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  items PermissionGroupItem[]

  @@map("permission_groups")
}

model PermissionGroupItem {
  id                String @id @default(uuid()) @db.Uuid
  permissionGroupId String @map("permission_group_id") @db.Uuid
  permissionId      String @map("permission_id") @db.Uuid

  permissionGroup PermissionGroup @relation(fields: [permissionGroupId], references: [id])
  permission      Permission      @relation(fields: [permissionId], references: [id])

  @@unique([permissionGroupId, permissionId])
  @@map("permission_group_items")
}

// ==========================================
// DYNAMIC STATION LOOKUP TABLES (Rule BE-11)
// ==========================================

model StationType {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isSales     Boolean   @default(true) @map("is_sales")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  stations    Station[]

  @@map("station_types")
}

model StationStatusLookup {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  isOperational Boolean   @default(true) @map("is_operational")
  isMaintenance Boolean   @default(false) @map("is_maintenance")
  color         String?
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  stations      Station[]

  @@map("station_status_lookups")
}

model StationAssignmentRole {
  id                 String                  @id @default(uuid()) @db.Uuid
  code               String                  @unique
  name               String
  canManageProfiles  Boolean                 @default(false) @map("can_manage_profiles")
  canOperate         Boolean                 @default(true) @map("can_operate")
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")

  assignments        StationUserAssignment[]

  @@map("station_assignment_roles")
}
