generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum SystemRole {
  SuperAdmin
  Admin
  Staff
}

enum ScopeResolutionStrategy {
  Global
  OwnDepartment
  OwnTeam
  OwnProject
  OwnProfile
  ExplicitDepartments
  ExplicitTeams
  ExplicitProjects
}

enum MessageStatus {
  Draft
  Pending
  Approved
  Hold
  Rejected
  Delivered
}

enum IssueStatus {
  NRI
  WIP
  Solve
  Wrong
}

enum GroupMemberSource {
  AutoManagement
  AutoAssignment
  Manual
}

enum AttachmentEntity {
  project
  message
  issue
  support_ticket
  chat_message
  platform_thread_message
  bd_order
}

enum ThreadDirection {
  Outbound
  Inbound
}
