# ==========================================
# 🌟 Softvence Monorepo Centralized Configuration
# ==========================================

# --- [1] Application Environment ---
NODE_ENV=development
PORT=3030
REQUEST_TIMEOUT=30000

# --- [2] PostgreSQL (Docker Compose: port 5439) ---
POSTGRES_USER=fiamanillah
POSTGRES_PASSWORD=fiamanillah
POSTGRES_DB=manage_project
POSTGRES_PORT=5439
DATABASE_URL="postgresql://fiamanillah:fiamanillah@localhost:5439/manage_project?schema=public"
DB_LOGGING=false

# --- [3] MongoDB Audit Log (Docker Compose: port 27017) ---
MONGO_URI="mongodb://root:rootpassword@localhost:27017/audit_db?authSource=admin"

# --- [4] RabbitMQ Message Broker (Docker Compose: port 5672) ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# --- [5] Redis Cache & PubSub (Docker Compose: port 6379) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ignitor:
REDIS_DEFAULT_TTL=3600

# --- [6] Authentication & Security ---
JWT_SECRET=supersecretjwtkeychangeinproduction
JWT_EXPIRES_IN=1d
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
JWT_ISSUER=ignitor-app
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=4

# --- [7] Default Admin User Seed ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=adminpassword123
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# --- [8] Express API Security & Rate Limiting ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- [9] Logging Configuration ---
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# --- [10] S3 / RustFS Object Storage (Docker Compose: S3 port 9000, Console 9001) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_PUBLIC_BUCKET=manage-project-public
S3_PRIVATE_BUCKET=manage-project-private
S3_FORCE_PATH_STYLE=true
S3_SSL_ENABLED=false
S3_PUBLIC_URL_PREFIX=

# --- [11] Frontend Dashboard (Next.js 15) ---
NEXT_PUBLIC_API_URL=http://localhost:3030/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3030

# --- [12] Frontend Web (Vite React) ---
VITE_API_URL=http://localhost:3030/api/v1
