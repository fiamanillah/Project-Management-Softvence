# Application Environment
NODE_ENV=development
PORT=3030
REQUEST_TIMEOUT=30000

# Database Configuration (Docker Compose PostgreSQL: port 5439)
POSTGRES_USER=fiamanillah
POSTGRES_PASSWORD=fiamanillah
POSTGRES_DB=manage_project
POSTGRES_PORT=5439
DATABASE_URL="postgresql://fiamanillah:fiamanillah@localhost:5439/manage_project?schema=public"
DB_LOGGING=false

# MongoDB Audit Log Configuration (Docker Compose MongoDB: port 27017)
MONGO_URI="mongodb://root:rootpassword@localhost:27017/audit_db?authSource=admin"

# RabbitMQ Configuration (Docker Compose RabbitMQ: port 5672)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Redis Configuration (Docker Compose Redis: port 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ignitor:
REDIS_DEFAULT_TTL=3600

# Authentication & Security
JWT_SECRET=supersecretjwtkeychangeinproduction
JWT_EXPIRES_IN=1d
JWT_ISSUER=ignitor-app

# Default Admin User
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=adminpassword123

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# S3 / Rust-S3 Object Storage (Docker Compose RustFS: S3 API port 9000, Console port 9001)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_PUBLIC_BUCKET=manage-project-public
S3_PRIVATE_BUCKET=manage-project-private
S3_FORCE_PATH_STYLE=true
S3_SSL_ENABLED=false
S3_PUBLIC_URL_PREFIX=
