meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

docs {
  ### Login User
  Authenticates a user with valid email and password credentials.

  **Authentication:** None (Public endpoint, rate-limited).

  **Request Body:**
  - `email` (string, required): Registered user email address.
  - `password` (string, required): User account password.

  **Response:**
  - `200 OK`: Returns authenticated user profile and sets HTTP-only cookies (`access_token` for 15m, `refresh_token` for 30 days).
  - `401 Unauthorized`: Returned if credentials are invalid or user account is inactive/deleted.
}
