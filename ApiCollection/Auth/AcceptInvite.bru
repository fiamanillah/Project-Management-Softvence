meta {
  name: Accept Invite
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/accept-invite
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{inviteToken}}",
    "password": "MyNewAccountPassword123!"
  }
}

docs {
  ### Accept User Invitation
  Sets password and activates account for a newly invited user.

  **Authentication:** None.

  **Request Body:**
  - `token` (string, required): Opaque invite token generated during user invitation.
  - `password` (string, required): Initial account password set by the user.

  **Response:**
  - `200 OK`: Sets account password, marks user `is_active = true`, and invalidates invite token.
  - `400 Bad Request`: Returned if token is invalid, expired, or already used.
}
