meta {
  name: Reset Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "BrandNewPassword123!"
  }
}

docs {
  ### Reset Password
  Resets an account password using a valid password reset token.

  **Authentication:** None.

  **Request Body:**
  - `token` (string, required): Opaque reset token received via email/notification.
  - `newPassword` (string, required): New password for the account.

  **Response:**
  - `200 OK`: Resets password and revokes all active refresh tokens.
  - `400 Bad Request`: Returned if reset token is invalid, expired, or already used.
}
