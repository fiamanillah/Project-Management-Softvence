meta {
  name: Forgot Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  ### Forgot Password Request
  Initiates a password reset request. Generates an opaque reset token and sends instructions.

  **Authentication:** None (Public endpoint, rate-limited).

  **Request Body:**
  - `email` (string, required): Account email address.

  **Response:**
  - `200 OK`: Always returns a generic success message to prevent user enumeration attacks.
}
