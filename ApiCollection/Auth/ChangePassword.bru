meta {
  name: Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "NewSuperSecretPassword123!"
  }
}

docs {
  ### Change User Password
  Changes the password for the currently logged-in user.

  **Authentication:** Requires valid `access_token` HTTP-only cookie.

  **Request Body:**
  - `currentPassword` (string, required): Existing account password.
  - `newPassword` (string, required): New password (must meet complexity requirements).

  **Response:**
  - `200 OK`: Returns success message and logs `USER_CHANGE_PASSWORD` audit event.
  - `400 Bad Request`: Returned if current password is incorrect or new password is invalid.
}
