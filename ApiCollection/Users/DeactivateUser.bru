meta {
  name: Deactivate User
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/users/:id/deactivate
  body: none
  auth: none
}

params:path {
  id: {{userId}}
}

docs {
  ### Deactivate User
  Deactivates a user account, preventing future logins and revoking refresh tokens.

  **Authentication:** Requires `access_token` and `user.deactivate` permission.

  **Path Parameters:**
  - `id` (string, required): Target user account ID.

  **Response:**
  - `200 OK`: Sets `is_active = false` and revokes all active refresh tokens for the target user.
  - `404 Not Found`: Returned if user ID is not found.
  - `403 Forbidden`: Returned if authenticated user lacks `user.deactivate` permission.
}
