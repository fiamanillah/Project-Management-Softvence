{
  "name": "Project-Management-Softvence",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "bun --filter @workspace/db db:migrate",
    "db:studio": "bun --filter @workspace/db db:studio",
    "bootstrap:admin": "bun --filter api bootstrap:admin",
    "sync:permissions": "bun --filter api sync:permissions",
    "db:seed": "bun --filter api db:seed",
    "seed:dummy": "bun --filter api seed:dummy"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
